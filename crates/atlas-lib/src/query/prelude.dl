% The prelude: questions the commands answer, written as rules over the
% facts so a program can read, join and extend them by name. Each relation
% here has a conformance test against the command it restates. A relation
% counted with `count` has no row where there is nothing to count: an
% absent row is not a 0.

% --- dependencies --relation calls -------------------------------------------

% One resolved call between functions in two different files, with its
% witness id. Calls inside one file are not dependencies between files.
file_call{from: A, to: B, call: C} :-
    call{id: C, from: F, to: G},
    function{id: F, path: A},
    function{id: G, path: B},
    A != B.

% File-level call edges and the number of calls behind each, the edges
% `dependencies --relation calls` draws. Restrict both ends with `under` to
% read one scope, as the command's SCOPE does:
%   ?- file_calls{from: A, to: B, calls: N}, under(A, "src"), under(B, "src").
% Only resolved calls count: unresolved ones are in `unknown_call`.
file_calls{from: A, to: B, calls: count(C)} :-
    file_call{from: A, to: B, call: C}.

% --- callers / callees -------------------------------------------------------

% One step of `callers` and `callees`: function F has at least one resolved
% call to function G. Unresolved calls are in `unknown_call`, never here.
calls_function{from: F, to: G} :-
    call{from: F, to: G}.

% The last segment of each function's name and of each unresolved call's
% spelling (`graph` for `Snapshot::graph` and for `snapshot.graph()`), so
% `possible_call` joins on it instead of testing every pair.
function_segment{function: F, segment: S} :-
    function{id: F, name: N},
    last_segment(N, S).
call_segment{call: C, segment: S} :-
    unknown_call{id: C, spelling: W},
    last_segment(W, S).

% An unresolved call C written with function F's name: the last segment of
% what was written equals the last segment of F's name. `callers F` lists
% these as "possibly", never as callers: read them before concluding that a
% function has no caller.
possible_call{to: F, call: C} :-
    function_segment{function: F, segment: S},
    call_segment{call: C, segment: S}.

% The functions F reaches through resolved calls, at any depth. `callees F
% --depth N` lists those within N steps, and `callers G --depth N` those that
% reach G within N; with enough depth both list exactly these rows:
%   ?- reaches{from: F, to: "src/lib.rs:7:4"}.
reaches{from: F, to: G} :-
    calls_function{from: F, to: G}.
reaches{from: F, to: H} :-
    reaches{from: F, to: G},
    calls_function{from: G, to: H}.

% --- semantic calls (query --scip FILE or --semantic) -------------------------

% A call from F to G by either reading, with which one said so: `qualified`
% (Atlas followed use statements and modules) or `semantic` (the SCIP index
% names G). A pair both readings name is two rows, never merged; the
% relations above stay qualified-only.
any_call{from: F, to: G, reading: "qualified"} :-
    call{from: F, to: G}.
any_call{from: F, to: G, reading: "semantic"} :-
    semantic_call{from: F, to: G}.

% --- name NAME --relations ----------------------------------------------------

% The production declarations `name` matches by their written name.
name_match{name: N, declaration: D} :-
    declaration{id: D, name: N, test_only: false}.

% A declaration's lexical card: each mention it makes (outgoing), each
% mention that names it alone (incoming), and each that names it among
% other candidates (possible). Mentions are spellings, not resolved uses.
name_card{name: N, declaration: D, relation: "outgoing", mention: E} :-
    name_match{name: N, declaration: D},
    mention{id: E, source: D}.
name_card{name: N, declaration: D, relation: "incoming", mention: E} :-
    name_match{name: N, declaration: D},
    mention_target{mention: E, target: D, basis: "unique"}.
name_card{name: N, declaration: D, relation: "possible", mention: E} :-
    name_match{name: N, declaration: D},
    mention_target{mention: E, target: D, basis: "candidate"}.

% --- census -------------------------------------------------------------------

% A path at least one package reads outside a test build.
production_path{path: P} :- file{path: P, test_only: false}.

% The workspace counts `census` reports, as (metric, key, n). `key` is the
% kind or package for `kinds` and `crates`, and "" otherwise. Declarations
% are counted once per package that reads them, files once per path.
census{metric: "files", key: "", n: count(P)} :-
    file{path: P}.
census{metric: "test_only_files", key: "", n: count(P)} :-
    file{path: P, test_only: true},
    !production_path{path: P}.
census{metric: "declarations", key: "", n: count(D, K)} :-
    declaration{id: D, package: K, test_only: false}.
census{metric: "kinds", key: Kind, n: count(D, K)} :-
    declaration{id: D, package: K, kind: Kind, test_only: false}.
census{metric: "crates", key: K, n: count(P)} :-
    file{path: P, package: K}.
census{metric: "relationships", key: "", n: count(E)} :-
    mention{id: E}.
census{metric: "ambiguous", key: "", n: count(E)} :-
    mention_target{mention: E, basis: "candidate"}.
census{metric: "unresolved", key: "", n: count(E)} :-
    mention_unresolved{mention: E}.
census{metric: "diagnostics", key: "", n: count(D)} :-
    diagnostic{id: D}.
